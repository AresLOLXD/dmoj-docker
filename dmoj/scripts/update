#!/bin/bash
cd $(dirname $(dirname $0)) || exit

echo "== Updating dmoj/repo submodule =="
git -C .. submodule update --init --recursive --remote --merge dmoj/repo
if [ $? -ne 0 ]; then
    echo "Error: submodule update failed" 1>&2
    exit 1
fi

echo ""
echo "== Rebuilding base, site, celery, bridged, wsevent =="
docker compose up -d --build base site celery bridged wsevent
if [ $? -ne 0 ]; then
    echo "Error: rebuild failed" 1>&2
    exit 1
fi

echo ""
echo "== Restarting site, celery, bridged, wsevent =="
# repo/ is mounted read-only at runtime rather than baked into the image, so
# a --build above that doesn't change the image (e.g. only repo/ source
# changed) won't make compose restart already-running containers on its own.
docker compose restart site celery bridged wsevent
if [ $? -ne 0 ]; then
    echo "Error: restart failed" 1>&2
    exit 1
fi

echo ""
echo "== Running migrations =="
./scripts/migrate
if [ $? -ne 0 ]; then
    echo "Error: migration failed" 1>&2
    exit 1
fi

echo ""
echo "Update complete."
echo "If static files changed upstream, run: ./scripts/copy_static"
